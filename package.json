{
	"name": "dailytodo",
	"version": "1.0.0",
	"description": "Roll over incomplete todos into today's daily TODO note.",
	"main": "main.js",
	"repository": {
		"type": "git",
		"url": "https://github.com/aaronarcade/Obsidian-Daily-Todo.git"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "SEAWARE",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	}
}
